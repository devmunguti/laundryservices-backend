PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=mongodb://localhost:27017/laundry_db
JWT_SECRET=your_jwt_secret_key_here

# PayHero M-Pesa Integration Credentials (Platform Level Only)
PAYHERO_API_KEY=your_payhero_api_key_here
PAYHERO_USERNAME=your_payhero_username_here
PAYHERO_PASSWORD=your_payhero_password_here
PAYHERO_CHANNEL_ID=your_payhero_channel_id_here
PAYHERO_BASE_URL=https://backend.payhero.co.ke
PAYHERO_CALLBACK_URL=http://localhost:5000/api/payments/payhero/callback

# ==============================================================================
# SMTP & EMAIL NOTIFICATION CONFIGURATION
# ==============================================================================
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM_ADDRESS=support@auralaundry.co.ke
EMAIL_FROM_NAME="Aura Laundry"
EMAIL_REPLY_TO=support@auralaundry.co.ke
EMAIL_ADMIN_ALERTS_TO=admin@auralaundry.co.ke

