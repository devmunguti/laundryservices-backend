PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mongodb://localhost:27017/laundry_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PayHero M-Pesa Integration Credentials (Platform Level Only)
PAYHERO_API_KEY=your_payhero_api_key_here
PAYHERO_USERNAME=your_payhero_username_here
PAYHERO_PASSWORD=your_payhero_password_here
PAYHERO_CHANNEL_ID=your_payhero_channel_id_here
PAYHERO_BASE_URL=https://backend.payhero.co.ke
PAYHERO_CALLBACK_URL=http://localhost:5000/api/payments/payhero/callback

# ==============================================================================
# EMAIL NOTIFICATION CONFIGURATION
# ==============================================================================
EMAIL_ENABLED=true

# Provider Selection (options: resend, brevo, sendgrid, smtp, mock)
# Production Recommendation: Use 'resend' on Render/Cloud (Port 443 HTTPS REST API)
EMAIL_PROVIDER=resend

# Cloud HTTP REST API Keys (HTTPS / Port 443 — Recommended for Render / Cloud)
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP Fallback Configuration (Local Development only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_or_gmail@gmail.com
SMTP_PASS=your_16_character_app_password

# Sender & Recipient Metadata
EMAIL_FROM_ADDRESS=support@auralaundry.co.ke
EMAIL_FROM_NAME="Aura Laundry"
EMAIL_REPLY_TO=support@auralaundry.co.ke
EMAIL_ADMIN_ALERTS_TO=admin@auralaundry.co.ke

# ==============================================================================
# SMS & NOTIFICATION CONFIGURATION
# ==============================================================================
SMS_ENABLED=false
SMS_PROVIDER=mock # options: africastalking, twilio, mock

# Africa's Talking Credentials
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SENDER_ID=AURA

# Twilio Credentials (Alternative Provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# In-App Notifications & OTP Settings
IN_APP_NOTIFICATIONS_ENABLED=true
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5



